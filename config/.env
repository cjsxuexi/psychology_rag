# 文本处理配置
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=50
MIN_TEXT_LENGTH=50

# m3e 模型配置
M3E_MODEL_NAME=moka-ai/m3e-base  #m3e-small为了快速测试。更推荐用 m3e-base
 # 批量生成向量大小（CPU：500 以内，GPU：2000 以内）
M3E_BATCH_SIZE=100
# m3e-base 生成 768 维向量，m3e-small 生成 512 维
EMBEDDING_DIM=768


# ========== 新增：qwen-plus 配置（企业级解耦） ==========
#QWEN_API_KEY=your_aliyun_dashscope_api_key  # 替换为你的qwen-plus API密钥
QWEN_MODEL_NAME=qwen-plus  # 模型名称，固定为qwen-plus
QWEN_TEMPERATURE=0.3       # 生成温度，与原GPT配置对齐
QWEN_MAX_TOKENS=1024       # 最大生成tokens
QWEN_TIMEOUT=30            # API调用超时时间（秒）
QWEN_RETRY_TIMES=2         # 调用失败重试次数

# ========== 原有配置（保留，无需修改） ==========
# RAG 问答配置
RAG_TOP_K=5
RAG_PROMPT_TEMPLATE_PATH=rag_prompt_template.txt
QA_TEMPERATURE=0.3
QA_MAX_TOKENS=1024

# FAISS 检索配置
FAISS_NPROBE=10
FAISS_EF_SEARCH=100
FAISS_INDEX_SAVE_PATH=faiss_million_m3e.index
PCA_VARIANCE_THRESHOLD=0.95
# FAISS PQ 量化配置（企业级：解耦，便于动态调整）
PQ_M_CANDIDATES=8,16,32  # 子量化器数量候选值（优先选择2的幂次，便于优化）
PQ_NBITS=8  # 每个子向量的量化比特数（常用8，平衡压缩比和精度）
FAISS_QUANTIZE_TYPE=PQ  # 量化类型：PQ（乘积量化）/ SQ（标量量化）

# MySQL数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=5455
MYSQL_DATABASE=my_rag
MYSQL_USER=root
MYSQL_PASSWORD=infini_rag_flow

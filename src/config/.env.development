# ============================================
# 开发环境配置
# ============================================
APP_ENV=development
APP_DEBUG=true

# 开发环境使用DEBUG级别，方便调试
LOG_LEVEL=DEBUG
LOG_FORMAT=simple

# 本地数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rag_dev
DB_USER=root
DB_PASSWORD=dev_password

# Milvus本地配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 开发环境使用较小的chunk方便测试
SPLITTER_CHUNK_SIZE=500
SPLITTER_CHUNK_OVERLAP=100

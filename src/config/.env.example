# ============================================
# 应用环境配置
# ============================================
# 环境类型: development | testing | production
APP_ENV=development
APP_DEBUG=true

# ============================================
# 日志配置
# ============================================
# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# 日志格式: simple | json
LOG_FORMAT=simple
# 单个日志文件最大大小（字节，默认10MB）
LOG_MAX_BYTES=10485760
# 保留日志文件数量
LOG_BACKUP_COUNT=5
# 日志保留天数
LOG_RETENTION_DAYS=7

# ============================================
# MySQL数据库配置
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_rag
DB_USER=root
DB_PASSWORD=your_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Milvus向量数据库配置
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_collection
MILVUS_DIMENSION=768

# ============================================
# 文本分割配置
# ============================================
# 分割器类型: recursive | character | token | llama_sentence | llama_sentence_window | llama_semantic | llama_combined
SPLITTER_TYPE=recursive
SPLITTER_CHUNK_SIZE=1000
SPLITTER_CHUNK_OVERLAP=200

# ============================================
# Embedding模型配置
# ============================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# 设备: cpu | cuda | auto
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32

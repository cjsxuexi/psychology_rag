# ============================================
# 生产环境配置
# ============================================
APP_ENV=production
APP_DEBUG=false

# 生产环境使用INFO级别，减少日志量
LOG_LEVEL=INFO
# 生产环境使用JSON格式，便于日志收集系统解析
LOG_FORMAT=json
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10
LOG_RETENTION_DAYS=30

# 生产数据库配置（请根据实际情况修改）
DB_HOST=prod-db.example.com
DB_PORT=3306
DB_DATABASE=rag_prod
DB_USER=rag_app
DB_PASSWORD=${DB_PASSWORD}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Milvus生产配置
MILVUS_HOST=milvus-cluster.example.com
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_production

# 生产环境使用较大的chunk提高性能
SPLITTER_CHUNK_SIZE=1000
SPLITTER_CHUNK_OVERLAP=200

# Embedding生产配置
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64
